{
  "manifest_version": 3,
  "name": "Real-Time Manga Translator",
  "version": "0.9.0",
  "description": "Scan manga reader panels, read them with an in-browser OCR pipeline, translate with Gemini, overlay the text.",
  "permissions": ["activeTab", "scripting", "storage", "offscreen", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Real-Time Manga Translator",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
